# Simkl — register an app (free, instant): https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=

# Trakt (phase 3): https://trakt.tv/oauth/applications
# OAuth device flow needs BOTH — the client_id requests the device code, the
# client_secret is required to exchange the approved code for an access token.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
