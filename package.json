{
  "name": "tvtime-migrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Migrate TV Time watch history to Simkl (and later Trakt) via API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node core/build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dry-run": "node simkl/import.mjs --dry-run",
    "import": "node simkl/import.mjs --commit",
    "verify": "node simkl/verify.mjs",
    "verify:core": "node core/verify.mjs",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3"
  }
}
