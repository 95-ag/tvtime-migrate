{
  "name": "tvtime-migrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Migrate TV Time watch history to Simkl (and later Trakt) via API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node core/build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "auth": "node --env-file=.env simkl/auth.mjs",
    "dry-run": "node simkl/dry-run.mjs",
    "probe": "node --env-file=.env simkl/probe.mjs",
    "import": "node --env-file=.env simkl/import.mjs",
    "verify": "node --env-file=.env simkl/verify.mjs",
    "franchise": "node --env-file=.env simkl/franchise.mjs",
    "recover": "node --env-file=.env simkl/recover.mjs",
    "verify:core": "node core/verify.mjs",
    "auth:trakt": "node --env-file=.env trakt/auth.mjs",
    "dry-run:trakt": "node trakt/dry-run.mjs",
    "probe:trakt": "node --env-file=.env trakt/probe.mjs",
    "import:trakt": "node --env-file=.env trakt/import.mjs",
    "verify:trakt": "node --env-file=.env trakt/verify.mjs",
    "recover:trakt": "node --env-file=.env trakt/recover.mjs",
    "resolve:trakt": "node --env-file=.env trakt/resolve-shows.mjs",
    "split:trakt": "node --env-file=.env trakt/season-splits.mjs",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3"
  }
}
